-- ---- privacy_requests -----------------------------------------------------
--  Yeu cau cua chu the du lieu. Sau ban va, pages/privacy_erase.php thuc hien
--  xoa va an danh hoa that, va cap nhat trang thai ban ghi nay thanh completed,
--  nen ban ghi tro thanh dau vet kiem toan.
CREATE TABLE IF NOT EXISTS privacy_requests (
    id         INT NOT NULL AUTO_INCREMENT,
    user_id    INT,
    kind       VARCHAR(20),
    reason     TEXT,
    status     VARCHAR(20) DEFAULT 'received',
    created_at DATETIME DEFAULT NOW(),
    PRIMARY KEY (id)
);

-- ---- credentials ----------------------------------------------------------
--  Bang tai khoan dich vu cu, bam bang MD5. Day la mot khiem khuyet THAT con lai
--  trong he thong, duoc giu de bao cao doi chieu voi GDPR Dieu 32: MD5 khong du
--  manh cho muc dich luu thong tin xac thuc. Chu so huu: Dao Xuan Manh.
CREATE TABLE IF NOT EXISTS legacy_service_accounts (
    id            INT NOT NULL AUTO_INCREMENT,
    username      VARCHAR(100),
    password_hash VARCHAR(64),
    api_key       VARCHAR(64),
    PRIMARY KEY (id)
);

