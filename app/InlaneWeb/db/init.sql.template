-- ============================================================================
--  IlFreight Logistics — init.sql.template   (BAN VA)
--
--  Khuon mau nay duoc entrypoint ket xuat thanh /docker-entrypoint-initdb.d/10-init.sql
--  sau khi chen mat khau tu bien moi truong. Nho vay khong mat khau nao nam
--  trong kho ma hay trong anh container.
--
--  Bon thay doi so voi ban cu:
--
--  1. P3, GDPR Dieu 32: KHONG tao 'root'@'%' voi ALL PRIVILEGES va quyen FILE.
--     Ung dung dung tai khoan ilf_app chi co bon quyen du de chay nghiep vu.
--     Bo kiem thu dung tai khoan rieng ilf_test, co quyen tren dung mot CSDL.
--
--  2. GDPR Dieu 32 va Dieu 5(1)(f): mat khau nguoi dung luu bang bcrypt thay vi
--     dang ro. Gia tri duoi day sinh bang password_hash(..., PASSWORD_DEFAULT).
--
--  3. Bo bang `flags` va cac co ILF{...}. Khong trang nao truy van bang do; no la
--     dao cu cua bai tap khai thac, khong thuoc mot he thong duoc danh gia.
--
--  4. Bang `credentials` duoc giu nhung dien giai lai thanh bang tai khoan dich
--     vu cu dung MD5. Day la mot khiem khuyet THAT theo GDPR Dieu 32: ham bam
--     khong du manh cho muc dich luu thong tin xac thuc.
-- ============================================================================

-- ---------------------------------------------------------------------------
--  Tai khoan: quyen toi thieu, khong cap FILE, khong cap GRANT OPTION
-- ---------------------------------------------------------------------------
CREATE DATABASE IF NOT EXISTS ilfreight CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

CREATE USER IF NOT EXISTS 'ilf_app'@'%'  IDENTIFIED BY '__APP_DB_PASSWORD__';
GRANT SELECT, INSERT, UPDATE, DELETE ON ilfreight.* TO 'ilf_app'@'%';

-- Tai khoan cho bo kiem thu: can tao va don chu the du lieu test, nen co quyen
-- rong hon, nhung chi tren dung CSDL ilfreight.
CREATE USER IF NOT EXISTS 'ilf_test'@'%' IDENTIFIED BY '__TEST_DB_PASSWORD__';
GRANT ALL PRIVILEGES ON ilfreight.* TO 'ilf_test'@'%';

FLUSH PRIVILEGES;

USE ilfreight;

-- ---- users ----------------------------------------------------------------
CREATE TABLE IF NOT EXISTS users (
    id             INT NOT NULL AUTO_INCREMENT,
    username       VARCHAR(100) UNIQUE NOT NULL,
    password       VARCHAR(255) NOT NULL,   -- bcrypt, khong con dang ro
    email          VARCHAR(150),
    role           VARCHAR(20) DEFAULT 'customer',
    api_key        VARCHAR(64),
    remember_token VARCHAR(64),
    PRIMARY KEY (id)
);

