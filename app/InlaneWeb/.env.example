# Khuon mau bien moi truong cho stack phat trien va kiem thu.
# Sao thanh .env roi dat gia tri thuc. .env KHONG duoc commit.
#
# Ba mat khau, ba vai tro khac nhau:
#   MYSQL_ROOT_PASSWORD  quan tri MariaDB, chi dung tu trong container db
#   APP_DB_PASSWORD      tai khoan ilf_app, ung dung dung, quyen toi thieu
#   TEST_DB_PASSWORD     tai khoan ilf_test, bo kiem thu dung, quyen tren mot CSDL
MYSQL_ROOT_PASSWORD=doi-gia-tri-nay
APP_DB_PASSWORD=doi-gia-tri-nay
TEST_DB_PASSWORD=doi-gia-tri-nay
VCS_REF=dev
